# 1. Ignore EVERYTHING (Files, folders, dotfiles)
*

# 2. Allow all directory structures 
# (Necessary so Git can see into folders to find the files listed below)
!*/

# 3. ROOT FILES - Manually Allow
!.gitignore
!/README.md
!/requirements.txt
!/requirements-dev.txt
!/examples/static.yml
!/examples/dynamic.yml
!/deploy/compose.telemetry.yml
!/deploy/compose.bot.yml
!/examples/compose.env
!/deploy/Dockerfile
!/.dockerignore
!/deploy/alloy.config
!/deploy/grafana-dashboard.json
!/examples/Dashboard.png


# 4. SRC FILES - Manually Allow
!/src/telegram_forwarder_bot/__init__.py
!/src/telegram_forwarder_bot/__main__.py
!/src/telegram_forwarder_bot/main.py
!/src/telegram_forwarder_bot/bot.py
!/src/telegram_forwarder_bot/config.py
!/src/telegram_forwarder_bot/config_watcher.py
!/src/telegram_forwarder_bot/metrics.py
!/src/telegram_forwarder_bot/monitoring.py
!/src/telegram_forwarder_bot/notification.py
!/src/telegram_forwarder_bot/admin_commands.py
!/src/telegram_forwarder_bot/storage.py
!/src/telegram_forwarder_bot/app_logging.py
!/src/telegram_forwarder_bot/retry.py
!/src/telegram_forwarder_bot/telegram_client.py

# 5. TOOLS - Manually Allow
!/tools/migrate_storage.py

# 6. TEST FILES - Manually Allow
!/tests/__init__.py
!/tests/conftest.py
!/tests/storage/__init__.py
!/tests/storage/test_correctness.py
!/tests/storage/test_performance.py
!/tests/storage/test_persistence.py
