# Copy this file to .compose.env in the repository root before starting the telemetry stack.
#
# Required secret. Do not commit the real value:
# GRAFANA_ADMIN_PASSWORD=

# All bot instance directories live below this path. Relative paths are resolved
# from the repository directory.
BOT_DATA_ROOT=./data

# Shared network used by the telemetry stack and independently managed bots.
TELEMETRY_NETWORK_NAME=telegram-forwarder-telemetry

# Grafana, InfluxDB, and Alloy listen on all host interfaces by default.
GRAFANA_BIND_ADDRESS=0.0.0.0
GRAFANA_PORT=3000
INFLUXDB_BIND_ADDRESS=0.0.0.0
INFLUXDB_HTTP_PORT=8181
ALLOY_BIND_ADDRESS=0.0.0.0
ALLOY_PORT=12345
